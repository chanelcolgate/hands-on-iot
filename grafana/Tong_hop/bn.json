      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": true,
                    "query": {
                      "datasource": {
                        "name": "dfvrph51qij9cc"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "groupBy": [],
                        "limit": "1",
                        "measurement": "caosu_measurement",
                        "orderByTime": "DESC",
                        "policy": "default",
                        "query": "SELECT \n    SUM(\"delta_value\") / 1000 AS \"energy\",\n    LAST(\"latitude\") AS \"energy_lat\",\n    LAST(\"longitude\") AS \"energy_lon\"\nFROM (\n    SELECT \n        NON_NEGATIVE_DERIVATIVE(LAST(\"value\"), 1h) AS \"delta_value\",\n        LAST(\"latitude\") AS \"latitude\",\n        LAST(\"longitude\") + 0.002 AS \"longitude\"\n    FROM \"caosu_measurement\"\n    WHERE (\n        \"system\"::tag = 'Hệ Mủ Tạp' \n        AND \"machine_name\"::tag = 'Điện Năng Tiêu Thụ'\n    )\n    AND $timeFilter\n    GROUP BY time(1h), \"machine_name\"::tag\n)\nWHERE $timeFilter\nGROUP BY time(7d, -7h), \"machine_name\"::tag fill(none)",
                        "rawQuery": true,
                        "resultFormat": "table",
                        "select": [
                          [
                            {
                              "params": [
                                "value"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [
                                " / 1000"
                              ],
                              "type": "math"
                            },
                            {
                              "params": [
                                "energy"
                              ],
                              "type": "alias"
                            }
                          ],
                          [
                            {
                              "params": [
                                "latitude"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [
                                "energy_lat"
                              ],
                              "type": "alias"
                            }
                          ],
                          [
                            {
                              "params": [
                                "longitude"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [
                                "+0.002"
                              ],
                              "type": "math"
                            },
                            {
                              "params": [
                                "energy_lon"
                              ],
                              "type": "alias"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "machine_name::tag",
                            "operator": "=",
                            "value": "Điện Năng Tiêu Thụ"
                          }
                        ]
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": true,
                    "query": {
                      "datasource": {
