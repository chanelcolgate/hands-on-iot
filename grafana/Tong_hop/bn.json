                        "orderByTime": "DESC",
                        "policy": "default",
                        "query": "SELECT \n    SUM(\"delta_value\") AS \"water\",\n    LAST(\"latitude\") AS \"water_latitude\",\n    LAST(\"longitude\") AS \"water_longitude\"\nFROM (\n    SELECT \n        NON_NEGATIVE_DERIVATIVE(LAST(\"value\"), 1h) AS \"delta_value\",\n        LAST(\"latitude\") AS \"latitude\",\n        LAST(\"longitude\") + 0.004 AS \"longitude\"\n    FROM \"caosu_measurement\"\n    WHERE (\n        \"system\"::tag = 'Hệ Mủ Tạp' \n        AND \"machine_name\"::tag = 'Lượng Nước Tiêu Thụ'\n    )\n    AND $timeFilter\n    GROUP BY time(1h), \"machine_name\"::tag\n)\nWHERE $timeFilter\nGROUP BY time(7d, -7h), \"machine_name\"::tag fill(none)",
                        "rawQuery": true,
