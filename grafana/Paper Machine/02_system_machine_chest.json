                        "policy": "default",
                        "query": "SELECT integral(\"pulpTPH\",1h)\nFROM \"dongtien_realtime\"\nWHERE (\n    \"factory\"='Giấy Đồng Tiến Long An'\n    AND \"system\"='System Machine Chest Back'\n    AND \"machine\"='PM6'\n    AND \"device\"='Pulp'\n)\nAND $timeFilter\nGROUP BY time(1h), \"device\"::tag, \"machine\"::tag fill(none)",
